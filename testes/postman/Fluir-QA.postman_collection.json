{
  "info": {
    "name": "Fluir - QA API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleção de QA para execução isolada em localhost (Postman/Newman). Não use contra produção. Resultados de cadastro utilizam dados fictícios."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    },
    {
      "key": "emailTeste",
      "value": "qa.postman@example.test"
    },
    {
      "key": "senhaTeste",
      "value": "SenhaFicticia123!"
    }
  ],
  "item": [
    {
      "name": "CT002 - Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/usuarios/teste"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CT002 HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('CT002 API funcionando', () => pm.expect(pm.response.text()).to.include('API do Fluir funcionando'));"
            ]
          }
        }
      ]
    },
    {
      "name": "CT007 - Login vazio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"\",\"senha\":\"\"}"
        },
        "url": "{{baseUrl}}/api/usuarios/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CT007 valida login vazio (400)', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "CT008 - Cadastro com email invalido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nome\":\"Pessoa QA\",\"email\":\"invalido\",\"senha\":\"SenhaFicticia123!\"}"
        },
        "url": "{{baseUrl}}/api/usuarios/cadastro"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CT008 email invalido rejeitado (400)', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "CT010 - Cadastro valido (base isolada)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nome\":\"Pessoa QA\",\"email\":\"{{emailTeste}}\",\"senha\":\"{{senhaTeste}}\"}"
        },
        "url": "{{baseUrl}}/api/usuarios/cadastro"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CT010 cadastro responde 201', () => pm.response.to.have.status(201));",
              "pm.test('CT010 corpo tem ID e email sem campo senha', () => { const data=pm.response.json(); pm.expect(data.id).to.be.a('number'); pm.expect(data.email).to.eql(pm.collectionVariables.get('emailTeste')); pm.expect(data).to.not.have.property('senha'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "CT009 - Cadastro duplicado",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"nome\":\"Pessoa QA\",\"email\":\"{{emailTeste}}\",\"senha\":\"{{senhaTeste}}\"}"
        },
        "url": "{{baseUrl}}/api/usuarios/cadastro"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CT009 cadastro duplicado responde 400', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    },
    {
      "name": "CT005 - Login valido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{emailTeste}}\",\"senha\":\"{{senhaTeste}}\"}"
        },
        "url": "{{baseUrl}}/api/usuarios/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CT005 login responde 200', () => pm.response.to.have.status(200));",
              "pm.test('CT005 token retornado (nao exibido)', () => {const d=pm.response.json(); pm.expect(d.token).to.be.a('string').and.not.empty;});"
            ]
          }
        }
      ]
    },
    {
      "name": "CT006 - Senha incorreta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"{{emailTeste}}\",\"senha\":\"senha-incorreta\"}"
        },
        "url": "{{baseUrl}}/api/usuarios/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CT006 login incorreto responde 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "CT023 - Tarefa sem titulo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"usuarioId\":1,\"titulo\":\"\"}"
        },
        "url": "{{baseUrl}}/api/tarefas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('CT023 titulo ausente rejeitado (400)', () => pm.response.to.have.status(400));"
            ]
          }
        }
      ]
    }
  ]
}
